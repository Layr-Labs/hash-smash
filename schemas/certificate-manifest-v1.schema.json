{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hashsmash.example/schemas/certificate-manifest-v1.schema.json",
  "title": "HashSmash certificate manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "certificates"],
  "properties": {
    "schema_version": { "const": 1 },
    "certificates": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "message_a", "message_b", "expected_digest"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
          },
          "type": { "const": "sha1-collision-witness-v1" },
          "message_a": {
            "type": "string",
            "pattern": "^certificates/[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
            "not": { "const": "certificates/manifest.json" }
          },
          "message_b": {
            "type": "string",
            "pattern": "^certificates/[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
            "not": { "const": "certificates/manifest.json" }
          },
          "expected_digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          }
        }
      }
    }
  }
}
