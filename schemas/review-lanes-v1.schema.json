{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hashsmash.example/schemas/review-lanes-v1.schema.json",
  "title": "HashSmash paired lane review v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "stage", "binding", "summary", "obligations", "heuristics", "findings", "cost_reconstruction", "challenge_resolutions", "prompt_injection_detected"],
  "properties": {
    "schema_version": {"type": "string", "enum": ["review-lanes-v1"]},
    "stage": {"type": "string", "enum": ["lane_evaluability", "lane_cryptanalysis", "lane_cost", "lane_experiments", "lane_defender", "lane_adjudicator"]},
    "binding": {
      "type": "object", "additionalProperties": false,
      "required": ["claim_sha256", "package_sha256", "target_config_sha256", "evidence_sha256"],
      "properties": {
        "claim_sha256": {"type": "string", "minLength": 64},
        "package_sha256": {"type": "string", "minLength": 64},
        "target_config_sha256": {"type": "string", "minLength": 64},
        "evidence_sha256": {"type": "string", "minLength": 64}
      }
    },
    "summary": {"type": "string", "minLength": 1},
    "obligations": {
      "type": "array", "maxItems": 16,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "status", "explanation", "evidence"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "status": {"type": "string", "enum": ["supported", "plausible", "unresolved", "fatal", "not_applicable"]},
          "explanation": {"type": "string", "minLength": 1},
          "evidence": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "heuristics": {
      "type": "array", "maxItems": 64,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "statement", "status", "tested_scope", "extrapolated_scope", "sensitivity", "evidence"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "statement": {"type": "string", "minLength": 1},
          "status": {"type": "string", "enum": ["established", "plausible", "unsupported", "refuted"]},
          "tested_scope": {"type": "string", "minLength": 1},
          "extrapolated_scope": {"type": "string", "minLength": 1},
          "sensitivity": {"type": "string", "minLength": 1},
          "evidence": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "findings": {
      "type": "array", "maxItems": 64,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "severity", "category", "statement", "obligation_ids", "heuristic_ids", "evidence"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "severity": {"type": "string", "enum": ["fatal", "material", "minor"]},
          "category": {"type": "string", "enum": ["counterexample", "invalid_inference", "target_mismatch", "cost_omission", "evidence_gap", "prompt_injection"]},
          "statement": {"type": "string", "minLength": 1},
          "obligation_ids": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"type": "string", "minLength": 1}},
          "heuristic_ids": {"type": "array", "maxItems": 64, "items": {"type": "string", "minLength": 1}},
          "evidence": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "cost_reconstruction": {
      "type": ["object", "null"], "additionalProperties": false,
      "required": ["time_log2", "time_unit", "memory_log2_bytes", "data_log2", "preprocessing_log2", "success_probability", "nonuniform_advice_log2_bytes", "normalized_score_log2", "calculation_trace"],
      "properties": {
        "time_log2": {"type": "number", "minimum": 0},
        "time_unit": {"type": "string", "minLength": 1},
        "memory_log2_bytes": {"type": "number", "minimum": 0},
        "data_log2": {"type": "number", "minimum": 0},
        "preprocessing_log2": {"type": "number", "minimum": 0},
        "success_probability": {"type": "number", "minimum": 0, "maximum": 1},
        "nonuniform_advice_log2_bytes": {"type": "number", "minimum": 0},
        "normalized_score_log2": {"type": "number", "minimum": 0},
        "calculation_trace": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "challenge_resolutions": {
      "type": "array", "maxItems": 256,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["finding_id", "result", "explanation", "evidence", "obligations_discharged"],
        "properties": {
          "finding_id": {"type": "string", "minLength": 1},
          "result": {"type": "string", "enum": ["confirmed", "refuted", "unresolved"]},
          "explanation": {"type": "string", "minLength": 1},
          "evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "obligations_discharged": {"type": "array", "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "prompt_injection_detected": {"type": "boolean"}
  }
}
