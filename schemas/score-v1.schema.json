{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hashsmash.example/schemas/score-v1.schema.json",
  "title": "HashSmash Yukon score v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "score", "metrics"],
  "properties": {
    "schema_version": { "const": 1 },
    "score": { "type": "number" },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewStatus",
        "targetProfile",
        "attackClass",
        "rounds",
        "timeLog2",
        "memoryLog2Bytes",
        "timeMemoryLog2",
        "dataLog2",
        "preprocessingLog2",
        "nonuniformAdviceLog2Bytes",
        "successProbability",
        "inputPackageSha256",
        "certificateReportSha256"
      ],
      "properties": {
        "reviewStatus": { "const": "ai_qualified" },
        "targetProfile": { "const": "sha1-fips180-4-v1" },
        "attackClass": { "const": "ordinary-collision" },
        "rounds": { "const": 80 },
        "timeLog2": { "type": "number" },
        "memoryLog2Bytes": { "type": "number" },
        "timeMemoryLog2": { "type": "number" },
        "dataLog2": { "type": "number" },
        "preprocessingLog2": { "type": "number" },
        "nonuniformAdviceLog2Bytes": { "type": "number" },
        "successProbability": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        "inputPackageSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "certificateReportSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "judgeConfigSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "dossierSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    }
  }
}
