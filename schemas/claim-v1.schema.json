{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hashsmash.example/schemas/claim-v1.schema.json",
  "title": "HashSmash SHA-1 pilot claim v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "target_profile",
    "attack_class",
    "rounds",
    "claim",
    "restrictions",
    "baseline_improved"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "target_profile": { "const": "sha1-fips180-4-v1" },
    "attack_class": { "const": "ordinary-collision" },
    "rounds": { "const": 80 },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "time_log2",
        "time_unit",
        "memory_log2_bytes",
        "data_log2",
        "preprocessing_log2",
        "success_probability",
        "nonuniform_advice_log2_bytes"
      ],
      "properties": {
        "time_log2": { "type": "number", "minimum": 0 },
        "time_unit": { "const": "sha1-compressions" },
        "memory_log2_bytes": { "type": "number", "minimum": 0 },
        "data_log2": { "type": "number", "minimum": 0 },
        "preprocessing_log2": { "type": "number", "minimum": 0 },
        "success_probability": { "type": "number", "minimum": 0.39, "maximum": 1 },
        "nonuniform_advice_log2_bytes": { "type": "number", "minimum": 0 }
      }
    },
    "restrictions": {
      "type": "array",
      "maxItems": 64,
      "items": { "type": "string", "minLength": 1, "maxLength": 1024 }
    },
    "baseline_improved": { "type": "string", "minLength": 1, "maxLength": 256 },
    "certificate_manifest": { "const": "certificates/manifest.json" }
  }
}
