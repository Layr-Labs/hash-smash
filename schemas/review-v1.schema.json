{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hashsmash.example/schemas/review-v1.schema.json",
  "title": "HashSmash AI review record v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "stage",
    "decision",
    "verdict",
    "claim",
    "issues",
    "verified_steps",
    "assumptions",
    "attempted_counterexamples",
    "submitted_cost",
    "recomputed_cost",
    "calculation_trace",
    "questions_for_author",
    "citations",
    "prompt_injection_detected",
    "confidence"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": ["review-v1"]
    },
    "stage": {
      "type": "string",
      "enum": ["triage", "correctness", "complexity", "adversarial", "synthesis"]
    },
    "decision": {
      "type": ["string", "null"],
      "enum": ["pass_to_review", "clarification_needed", "out_of_scope", null]
    },
    "verdict": {
      "type": ["string", "null"],
      "enum": [
        "supported",
        "unsupported",
        "unclear",
        "no_known_blocker",
        "author_response_required",
        "major_blocker",
        "advance",
        "request_revision",
        "seek_specialist",
        "reject",
        null
      ]
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_profile", "attack_class", "rounds", "summary", "restrictions"],
      "properties": {
        "target_profile": {"type": "string", "minLength": 1},
        "attack_class": {"type": "string", "minLength": 1},
        "rounds": {"type": "integer", "minimum": 1},
        "summary": {"type": "string", "minLength": 1},
        "restrictions": {
          "type": "array",
          "items": {"type": "string"}
        }
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["severity", "category", "description", "evidence"],
        "properties": {
          "severity": {
            "type": "string",
            "enum": ["fatal", "material", "minor"]
          },
          "category": {"type": "string", "minLength": 1},
          "description": {"type": "string", "minLength": 1},
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "verified_steps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["description", "evidence"],
        "properties": {
          "description": {"type": "string", "minLength": 1},
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["description", "effect", "evidence"],
        "properties": {
          "description": {"type": "string", "minLength": 1},
          "effect": {"type": "string", "minLength": 1},
          "evidence": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "attempted_counterexamples": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["description", "result", "evidence"],
        "properties": {
          "description": {"type": "string", "minLength": 1},
          "result": {
            "type": "string",
            "enum": ["refuted", "survives", "inconclusive"]
          },
          "evidence": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "submitted_cost": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": [
        "time_log2",
        "time_unit",
        "memory_log2_bytes",
        "data_log2",
        "preprocessing_log2",
        "success_probability",
        "nonuniform_advice_log2_bytes",
        "normalized_score_log2"
      ],
      "properties": {
        "time_log2": {"type": "number"},
        "time_unit": {"type": "string", "minLength": 1},
        "memory_log2_bytes": {"type": "number"},
        "data_log2": {"type": "number"},
        "preprocessing_log2": {"type": "number"},
        "success_probability": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "nonuniform_advice_log2_bytes": {"type": "number"},
        "normalized_score_log2": {"type": "number"}
      }
    },
    "recomputed_cost": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": [
        "time_log2",
        "time_unit",
        "memory_log2_bytes",
        "data_log2",
        "preprocessing_log2",
        "success_probability",
        "nonuniform_advice_log2_bytes",
        "normalized_score_log2"
      ],
      "properties": {
        "time_log2": {"type": "number"},
        "time_unit": {"type": "string", "minLength": 1},
        "memory_log2_bytes": {"type": "number"},
        "data_log2": {"type": "number"},
        "preprocessing_log2": {"type": "number"},
        "success_probability": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "nonuniform_advice_log2_bytes": {"type": "number"},
        "normalized_score_log2": {"type": "number"}
      }
    },
    "calculation_trace": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "questions_for_author": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "citations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["location", "supports"],
        "properties": {
          "location": {"type": "string", "minLength": 1},
          "supports": {"type": "string", "minLength": 1}
        }
      }
    },
    "prompt_injection_detected": {"type": "boolean"},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1}
  }
}
